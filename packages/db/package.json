{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/sqlite/index.ts",
    "./sqlite": "./src/sqlite/index.ts",
    "./sqlite/migrations": "./src/sqlite/migrations.ts",
    "./sqlite/zod": "./src/sqlite/zod/index.ts",
    "./sqlite/schema/*": "./src/sqlite/schema/*.ts",
    "./sqlite/schema/resume": "./src/sqlite/schema/resume/index.ts",
    "./sqlite/schema/resume/*": "./src/sqlite/schema/resume/*.ts",
    "./migrations": "./src/sqlite/migrations.ts",
    "./zod": "./src/sqlite/zod/index.ts",
    "./schema/*": "./src/sqlite/schema/*.ts",
    "./schema/resume": "./src/sqlite/schema/resume/index.ts",
    "./schema/resume/*": "./src/sqlite/schema/resume/*.ts",
    "./postgres": "./src/postgres/index.ts",
    "./postgres/schema/*": "./src/postgres/schema/*.ts",
    "./postgres/schema/resume": "./src/postgres/schema/resume/index.ts",
    "./postgres/zod": "./src/postgres/zod/index.ts",
    "./postgres/migrations": "./src/postgres/migrations.ts"
  },
  "scripts": {
    "dev": "vp build --watch",
    "build": "vp build",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.sqlite.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:migrate:postgres": "drizzle-kit migrate --config drizzle.postgres.config.ts",
    "db:push": "drizzle-kit push --config drizzle.sqlite.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.sqlite.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
