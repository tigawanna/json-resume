{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts",
    "./zod": "./src/zod/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./schema/resume": "./src/schema/resume/index.ts",
    "./schema/resume/*": "./src/schema/resume/*.ts"
  },
  "scripts": {
    "dev": "vp build --watch",
    "build": "vp build",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.9",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
