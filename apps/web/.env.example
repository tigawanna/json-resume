VITE_API_URL=http://localhost:3040

# React component tree for Chrome DevTools MCP. Dev only. Leave unset to skip.
# VITE_REACT_DEVTOOLS_MCP=true

# Skip the sign-in gate on hosted AI chats. Honored only in `vite` dev, ignored in production builds.
# VITE_AI_ALLOW_ANONYMOUS=true

# Desktop builds talk to the model with the user's own key and do not require an account.
# VITE_DESKTOP=true

VITE_SENTRY_DSN=http://7a33a22c45678b05be6e6b227510d6bd@127.0.0.1:8080/default-project 

LOG_DEBUG=true

# Public origin of apps/api (Hono RPC). Defaults to http://localhost:3100.
VITE_HONO_API_URL=http://localhost:4040

# Public origin of apps/nest (OpenAPI/Kubb client).
VITE_NEST_API_URL=http://localhost:5040

# Résumé credits (UI flag). Enforcement lives on Nest.
# VITE_CREDITS_ENABLED=true
