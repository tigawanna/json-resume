# Copy to apps/nest/.env. Values already in the shell win over this file.
# In development, a missing key also falls back to apps/web/.env.

NODE_ENV=development
PORT=5040

POSTGRES_URL=postgresql://dennis@localhost:5432/agentic_json_resume_nest
POSTGRES_POOL_MAX=2
# Tests create/drop their own databases through this role.
NEST_TEST_POSTGRES_URL=postgresql://dennis@localhost:5432/postgres
# Optional migrated snapshot used by the real-data admin suites.
NEST_TEST_POSTGRES_SOURCE=postgresql://dennis@localhost:5432/agentic_json_resume_nest

# Public origin written into OpenAPI `servers` (Scalar "Try it").
SERVER_URL=http://localhost:5040

BETTER_AUTH_SECRET=
# ${NAME} is expanded in validateEnv (Node --env-file does not expand it).
BETTER_AUTH_URL=${SERVER_URL}
FRONTEND_URL=http://localhost:3040
BETTER_AUTH_TRUSTED_ORIGINS=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Desktop/local-only hosted AI may run without an account. Never enable in production.
HOSTED_AI_ALLOW_ANONYMOUS=

# Development only. Send the same value as header x-admin. Must stay empty in production.
ADMIN_BYPASS_SECRET=

# Set to "true" to charge one credit per projected résumé. Leave unset to ship
# the credits UI in read-only mode; a warning is logged at boot in production.
CREDITS_ENABLED=
# ISO instant; résumés created before it are free (legacy imports).
CREDITS_START_AT=

# In production Observe turns on by itself when both keys are present.
# Run `npx @nestjs/observe link` to issue them.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
