{
  "name": "nest",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --env-file .env",
    "dev": "nest start --watch --env-file .env",
    "debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "db:migrate": "pnpm --dir ../../packages/db db:migrate",
    "db:migrate:postgres": "pnpm --dir ../../packages/db db:migrate:postgres",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:pgbox": "node scripts/with-pgboxdb.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.18",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-node": "^12.6.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@orpc/openapi": "^1.16.2",
    "@orpc/server": "^1.16.2",
    "@orpc/zod": "^1.16.2",
    "@repo/db": "workspace:*",
    "@repo/isomorphic": "workspace:*",
    "@scalar/nestjs-api-reference": "^1.2.41",
    "@tanstack/ai": "1.0.0",
    "@tanstack/ai-compaction": "1.0.0",
    "@tanstack/ai-openrouter": "1.0.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "nestjs-zod": "^5.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
