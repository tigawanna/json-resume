# Optional KRA overrides. The app merges these over src/lib/calculator/kra-rates.json.
# Precedence: shipped JSON < VITE_KRA_RATES_JSON < individual VITE_KRA_* variables.

# Partial JSON override:
# VITE_KRA_RATES_JSON='{"paye":{"personalReliefAnnual":30000},"nssf":{"upperEarningsLimit":120000}}'

# Labels:
# VITE_KRA_TAX_YEAR=2026
# VITE_KRA_REVIEWED=November 2026

# PAYE:
# VITE_KRA_PERSONAL_RELIEF_ANNUAL=28800
# VITE_KRA_PAYE_BANDS_JSON='[{"label":"First 288,000","upTo":288000,"rate":0.1},{"label":"Above 288,000","upTo":null,"rate":0.2}]'

# NSSF:
# VITE_KRA_NSSF_EMPLOYEE_RATE=0.06
# VITE_KRA_NSSF_EMPLOYER_RATE=0.06
# VITE_KRA_NSSF_LOWER_LIMIT=9000
# VITE_KRA_NSSF_UPPER_LIMIT=108000

# SHIF:
# VITE_KRA_SHIF_RATE=0.0275
# VITE_KRA_SHIF_MINIMUM=300

# Affordable Housing Levy:
# VITE_KRA_AHL_EMPLOYEE_RATE=0.015
# VITE_KRA_AHL_EMPLOYER_RATE=0.015

# NITA:
# VITE_KRA_NITA_MONTHLY=50
