{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "@api/*": [
        "./src/*"
      ],
      "@/*": [
        "../../web/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
