# Copy to `.env` or keep using `apps/web/.env` (dev fallback).
NODE_ENV=development
PORT=3100

# Same database as apps/web.
DATABASE_URL=file:../web/.local-db/json-resume-latest.db
DATABASE_AUTH_TOKEN=

BETTER_AUTH_SECRET=replace-me
# Public origin of this API. GitHub OAuth callback: {BETTER_AUTH_URL}/api/auth/callback/github
BETTER_AUTH_URL=http://localhost:3100
# Public origin of the web app (CORS + trusted origin).
FRONTEND_URL=http://localhost:3040
# Extra comma-separated origins (desktop, preview deploys).
BETTER_AUTH_TRUSTED_ORIGINS=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CRON_SECRET=
