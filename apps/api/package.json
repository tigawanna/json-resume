{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "vp pack src/index.ts --platform node --out-dir dist",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "check-types": "tsgo --noEmit"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.18",
