    "@libsql/client": "^0.17.2",
    "@repo/db": "workspace:*",
    "@repo/isomorphic": "workspace:*",
    "better-auth": "^1.7.18",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "evlog": "^2.16.0",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.2.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.1.0"
  }
