<mxfile host="65bd71144e">
    <diagram id="diagram-1" name="AWS Sync Architecture">
        <mxGraphModel dx="264" dy="233" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Résumé sync log — architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#102033;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="1100" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Every client call enters through API Gateway, which rejects a missing or expired JWT. Sync is DynamoDB and Lambda. Credit, wallets, REST, and remote MCP stay on the existing API." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#243044;" parent="1" vertex="1">
                    <mxGeometry x="40" y="52" width="1280" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="lane_api" value="Existing API  ·  Turso, later Postgres" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;arcSize=4;fillColor=#f7f9fc;strokeColor=#5d7394;strokeWidth=1.5;fontColor=#102033;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="220" y="110" width="1220" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="lane_sync" value="Sync stack  ·  DynamoDB + Lambda" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;arcSize=4;fillColor=#f7f9fc;strokeColor=#5d7394;strokeWidth=1.5;fontColor=#102033;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="220" y="450" width="1220" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="lane_mat" value="Materialization  ·  DynamoDB Streams to projected tables" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;arcSize=4;fillColor=#f7f9fc;strokeColor=#5d7394;strokeWidth=1.5;fontColor=#102033;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="220" y="780" width="1220" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="existing_api" value="Existing API credit gate · wallets · REST · remote MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6e6fa;strokeColor=#1f4e89;fontColor=#102033;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="480" y="168" width="320" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="jwt_note" value="Session check — a call with no JWT, or an expired one, is rejected at the gateway. Credit-status and sync both enter here; Sync Lambda is not a public endpoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7f3;strokeColor=#E7157B;fontColor=#3b1028;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
                    <mxGeometry x="480" y="264" width="900" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="bubble_credit" value="Credit gate — checks available credits, spends what the operation costs, and returns proceed or stop. On stop the client never calls sync, so an empty wallet writes nothing to the log. Charging lives here; the projector no longer decides billing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0fc;strokeColor=#1f4e89;fontColor=#102033;fontSize=13;align=left;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
                    <mxGeometry x="480" y="320" width="900" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="bubble_sync" value="Sync Lambda — one function in front of the log. Push appends events for the session user and returns the new per-user sequence. Pull queries seq greater than the cursor. It never reads or writes the wallet, and it does not project." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#c46a00;fontColor=#3a2408;fontSize=13;align=left;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
                    <mxGeometry x="460" y="520" width="620" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="streams" value="DynamoDB Streams change stream on the event log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6fb;strokeColor=#5b2d9e;fontColor=#2a1248;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="280" y="850" width="250" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="bubble_mat" value="Stream materializer — consumes the event-log stream and writes the projected tables into the existing API store (Turso now, Postgres later). A separate function from the Sync Lambda: a device that only syncs never needs these tables." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe6fb;strokeColor=#5b2d9e;fontColor=#2a1248;fontSize=13;align=left;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
                    <mxGeometry x="820" y="840" width="560" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="device" value="Device" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#102033;fontStyle=1;labelBackgroundColor=#f7f9fc;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;fillColor=#232F3D" parent="1" vertex="1">
                    <mxGeometry x="40" y="320" width="72" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="api_gateway" value="API Gateway" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#102033;fontStyle=1;labelBackgroundColor=#f7f9fc;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#E7157B" parent="1" vertex="1">
                    <mxGeometry x="280" y="196" width="64" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="turso" value="Turso / Postgres" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#102033;fontStyle=1;labelBackgroundColor=#f7f9fc;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#3B48CC" parent="1" vertex="1">
                    <mxGeometry x="1220" y="168" width="64" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="sync_lambda" value="Sync Lambda" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#102033;fontStyle=1;labelBackgroundColor=#f7f9fc;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100" parent="1" vertex="1">
                    <mxGeometry x="280" y="540" width="64" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="dynamodb" value="Event log" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#102033;fontStyle=1;labelBackgroundColor=#f7f9fc;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3B48CC" parent="1" vertex="1">
                    <mxGeometry x="1200" y="530" width="64" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="materializer" value="Materializer" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#102033;fontStyle=1;labelBackgroundColor=#f7f9fc;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100" parent="1" vertex="1">
                    <mxGeometry x="640" y="868" width="64" height="64" as="geometry"/>
                </mxCell>
