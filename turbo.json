{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", ".output/**", "dist/**"],
      "env": [
        "VITE_API_URL",
        "VITE_API_ORIGIN",
        "VITE_NEST_API_URL",
        "VITE_HONO_API_URL",
        "VITE_SENTRY_DSN",
        "VITE_CREDITS_ENABLED",
        "LOG_DEBUG"
      ]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["POSTGRES_URL", "NEST_TEST_POSTGRES_URL", "NEST_TEST_POSTGRES_SOURCE"]
    },
    "test:e2e:smoke": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
